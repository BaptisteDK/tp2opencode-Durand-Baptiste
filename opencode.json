{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "architect",
  "model": "deepseek-v4.1-flash",
  "small_model": "deepseek-v4.1-flash",
  "mcp": {
    "salles-db": {
      "type": "remote",
      "url": "https://mcp.internal.salles.lan/db",
      "enabled": false,
      "headers": {
        "Authorization": "Bearer {env:SALLES_MCP_TOKEN}"
      }
    },
    "github": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "enabled": true
    },
    "notion": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@notionhq/notion-mcp-server"
      ],
      "enabled": false
    },
    "slack": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-slack"
      ],
      "enabled": false
    },
    "sentry": {
      "type": "remote",
      "url": "https://mcp.sentry.dev/mcp",
      "enabled": false,
      "oauth": {}
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@latest"
      ],
      "enabled": false
    }
  }
}
